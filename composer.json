{
    "name": "neos/api",
    "type": "neos-package",
    "description": "HTTP API for Neos, defined with neos/openapi and secured by neos/oauth",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "neos/flow": "^9.2",
        "neos/neos": "^9.2",
        "neos/media": "^9.2",
        "neos/oauth": "dev-main",
        "behat/transliterator": "^1.5",
        "doctrine/dbal": "^3.8",
        "neos/openapi": "dev-main",
        "neos/openapi-flowadapter": "dev-main",
        "neos/schematic": "dev-main",
        "neos/jsonschema": "dev-main"
    },
    "suggest": {
        "neos/api-docs": "Swagger UI for the API on /api/docs"
    },
    "autoload": {
        "psr-4": {
            "Neos\\Api\\": "Classes/"
        }
    },
    "extra": {
        "neos": {
            "package-key": "Neos.Api"
        }
    }
}
