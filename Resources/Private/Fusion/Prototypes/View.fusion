##
# A view of the API: GET /api/views/{viewName}?contentRepositoryId=…&aggregateId=…&workspaceName=…&dimensionSpacePoint=…
# renders it for a node (without one, for the default site's site node; live and the site's default dimension space
# point unless given), once it is made available under the name in the Neos.Api.views settings
#
# It is a data structure, every key becomes a property of the JSON object. The context is the same as in the
# frontend: node, documentNode and site, with the globals request and renderingMode (frontend unless the request
# asks for another one, e.g. inPlace for the Neos UI: check renderingMode.isEdit for editing metadata).
# The JSON is encoded here, in Fusion, so the view renders a string like any other prototype
#
#   prototype(Vendor.Site:Api.MainNavigation) < prototype(Neos.Api:View) {
#       items = Neos.Fusion:Map {
#           items = ${q(site).children('[instanceof Neos.Neos:Document]').get()}
#           itemRenderer = Neos.Fusion:DataStructure {
#               aggregateId = ${item.aggregateId.value}
#               label = ${q(item).label()}
#           }
#       }
#   }
#
prototype(Neos.Api:View) < prototype(Neos.Fusion:DataStructure) {
    @process.json = ${Json.stringify(value)}
}
